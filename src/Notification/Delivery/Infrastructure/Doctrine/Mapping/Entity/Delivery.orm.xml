<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Notification\Delivery\Domain\Entity\Delivery" table="delivery" repository-class="App\Notification\Delivery\Infrastructure\Repository\DeliveryRepository">
        <id name="id" type="delivery_id" column="id" length="255" />

        <field name="notificationId" type="notification_id" column="notification_id" length="255" />
        <field name="notificationType" type="notification_type" column="notification_type" length="255" />
        <field name="communicationChannel" type="communication_channel" column="communication_channel" length="255" />
        <field name="notificationData" type="json" column="notification_data" />
        <embedded name="recipient" class="App\Notification\Shared\Domain\ValueObject\Recipient" prefix="recipient_" />
    </entity>

</doctrine-mapping>
