<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\Notification\Shared\Domain\ValueObject\Recipient">
        <field name="customerIdentifier" type="string" column="customer_identifier" length="255" />
        <field name="email" type="email" column="email" length="255" />
        <field name="phone" type="phone" column="phone" length="255" />
    </embeddable>

</doctrine-mapping>
